// Heightmap material, like ogre2's Terra with gz's height based weights:
// layer 0 covers the terrain, layer i > 0 fades in over
// smoothstep(minHeight[i], maxHeight[i], height above the terrain bottom).
// uv0: terrain coordinates in [0, 1], tiled per layer by tileU/tileV.
// uv1.x: height above the terrain bottom.
material {
    name : gz_terrain,
    shadingModel : lit,
    requires : [ uv0, uv1 ],
    parameters : [
        { type : int,       name : layers },
        // bit i set: layer i has a normal map
        { type : int,       name : normalFlags },
        { type : float4,    name : tileU, precision : high },
        { type : float4,    name : tileV, precision : high },
        { type : float4,    name : minHeight, precision : high },
        { type : float4,    name : maxHeight, precision : high },
        { type : float,     name : roughness },
        { type : sampler2d, name : diffuse0 },
        { type : sampler2d, name : diffuse1 },
        { type : sampler2d, name : diffuse2 },
        { type : sampler2d, name : diffuse3 },
        { type : sampler2d, name : normal0 },
        { type : sampler2d, name : normal1 },
        { type : sampler2d, name : normal2 },
        { type : sampler2d, name : normal3 }
    ]
}

fragment {
    // matc flips uv0.y: tile the unflipped coordinates, flip back
    highp vec2 layerUv(highp vec2 uv, int i) {
        return vec2(uv.x * materialParams.tileU[i],
                    1.0 - (1.0 - uv.y) * materialParams.tileV[i]);
    }

    void material(inout MaterialInputs material) {
        highp vec2 uv = getUV0();
        highp float h = getUV1().x;
        int n = materialParams.layers;
        int nf = materialParams.normalFlags;
        vec4 w = smoothstep(materialParams.minHeight, materialParams.maxHeight,
                            vec4(h));
        w.x = 1.0;

        vec3 c = texture(materialParams_diffuse0, layerUv(uv, 0)).rgb;
        vec2 nxy = (nf & 1) != 0 ?
            texture(materialParams_normal0, layerUv(uv, 0)).xy * 2.0 - 1.0 :
            vec2(0.0);
        if (n > 1) {
            c = mix(c,
                texture(materialParams_diffuse1, layerUv(uv, 1)).rgb, w.y);
            vec2 t = (nf & 2) != 0 ?
                texture(materialParams_normal1, layerUv(uv, 1)).xy * 2.0 - 1.0 :
                vec2(0.0);
            nxy = mix(nxy, t, w.y);
        }
        if (n > 2) {
            c = mix(c,
                texture(materialParams_diffuse2, layerUv(uv, 2)).rgb, w.z);
            vec2 t = (nf & 4) != 0 ?
                texture(materialParams_normal2, layerUv(uv, 2)).xy * 2.0 - 1.0 :
                vec2(0.0);
            nxy = mix(nxy, t, w.z);
        }
        if (n > 3) {
            c = mix(c,
                texture(materialParams_diffuse3, layerUv(uv, 3)).rgb, w.w);
            vec2 t = (nf & 8) != 0 ?
                texture(materialParams_normal3, layerUv(uv, 3)).xy * 2.0 - 1.0 :
                vec2(0.0);
            nxy = mix(nxy, t, w.w);
        }
        if (nf != 0) {
            // tangent space normal, z rebuilt from xy like Ogre
            material.normal = vec3(nxy, sqrt(max(1.0 - dot(nxy, nxy), 0.0)));
        }
        prepareMaterial(material);
        material.baseColor = vec4(c, 1.0);
        material.roughness = materialParams.roughness;
        material.metallic = 0.0;
    }
}
