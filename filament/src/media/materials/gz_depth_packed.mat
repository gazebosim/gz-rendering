// gz_depth for an RGBA8 target (used on Vulkan, see PackedDepth in
// FilamentDepthCamera.cc): same depth, written as the 4 bytes of its float
// bits so the readback is a plain copy that gives back the exact float.
material {
    name : gz_depth_packed,
    shadingModel : unlit,
    requires : [ uv0 ],
    blending : opaque,
    depthWrite : true,
    parameters : [
        { type : sampler2d, name : alphaMap, precision : high },
        { type : float, name : alphaThreshold, precision : high }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // alpha tested meshes (FilamentSubMesh::ApplyInstance): ogre2's
        // sensor passes keep the alpha test. Threshold 0 keeps everything.
        if (texture(materialParams_alphaMap, getUV0()).a <
                materialParams.alphaThreshold) {
            discard;
        }
        vec4 viewPos = getViewFromWorldMatrix() * vec4(getWorldPosition(), 1.0);
        // least significant byte in red: read back as little endian floats
        highp uint bits = floatBitsToUint(-viewPos.z);
        material.baseColor = vec4((uvec4(bits) >> uvec4(0u, 8u, 16u, 24u)) & 0xffu) / 255.0;
    }
}
