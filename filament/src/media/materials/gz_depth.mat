// Depth sensor material: the linear view-space depth (distance along the
// camera's optical axis, in meters) as the 4 bytes of its float bits, least
// significant in red, into an RGBA8 render target (see
// filament_utils::kPackedInf). A float target would not do: filament's GLES
// shaders write their color at mediump, which drivers may round to half
// precision (Mesa's llvmpipe does).
material {
    name : gz_depth,
    shadingModel : unlit,
    requires : [ uv0 ],
    blending : opaque,
    depthWrite : true,
    parameters : [
        { type : sampler2d, name : alphaMap, precision : high },
        { type : float, name : alphaThreshold, precision : high }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // alpha tested meshes (FilamentSubMesh::ApplyInstance): ogre2's
        // sensor passes keep the alpha test. Threshold 0 keeps everything.
        if (texture(materialParams_alphaMap, getUV0()).a <
                materialParams.alphaThreshold) {
            discard;
        }
        highp vec4 viewPos =
            getViewFromWorldMatrix() * vec4(getWorldPosition(), 1.0);
        highp uint bits = floatBitsToUint(-viewPos.z);
        material.baseColor =
            vec4((uvec4(bits) >> uvec4(0u, 8u, 16u, 24u)) & 0xffu) / 255.0;
    }
}
