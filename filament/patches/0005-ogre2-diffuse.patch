+// ogre2's diffuse (Ogre PBS Default BRDF, patch 0005): normalized Disney diffuse (Frostbite,
+// energy factor 1 -> 1/1.51 with roughness) weighted by 1 - the specular Fresnel
 vec3 diffuseLobe(const PixelParams pixel, float NoV, float NoL, float LoH) {
-    return pixel.diffuseColor * diffuse(pixel.roughness, NoV, NoL, LoH);
+    float r = pixel.perceptualRoughness;
+    float fd90 = 0.5 * r + 2.0 * LoH * LoH * r;
+    float lightScatter = 1.0 + (fd90 - 1.0) * pow5(1.0 - NoL);
+    float viewScatter = 1.0 + (fd90 - 1.0) * pow5(1.0 - NoV);
+    float energyFactor = mix(1.0, 1.0 / 1.51, r);
+#if !defined(SHADING_MODEL_SPECULAR_GLOSSINESS)
+    float fresnelD = 1.0 - max3(F_Schlick(pixel.diffuseF0, LoH));
+#else
+    float fresnelD = 1.0 - max3(F_Schlick(pixel.f0, LoH));
+#endif
+    return pixel.diffuseColor *
+            (Fd_Lambert() * lightScatter * viewScatter * energyFactor * fresnelD);
 }
 
