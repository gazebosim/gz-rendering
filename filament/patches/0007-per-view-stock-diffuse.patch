diff --git a/libs/filabridge/include/filament/MaterialEnums.h b/libs/filabridge/include/filament/MaterialEnums.h
index 5b78b479..3240034c 100644
--- a/libs/filabridge/include/filament/MaterialEnums.h
+++ b/libs/filabridge/include/filament/MaterialEnums.h
@@ -31,7 +31,7 @@
 namespace filament {
 
 // update this when a new version of filament wouldn't work with older materials
-static constexpr size_t MATERIAL_VERSION = 80; // local patch 0004 (79 + per-light specular scale)
+static constexpr size_t MATERIAL_VERSION = 81; // local patches 0004 (80: per-light specular scale), 0007 (81: per-view stock diffuse; 0006 is reserved)
 
 // Those are the api levels that are used in the source material file (.mat)
 //
diff --git a/shaders/src/surface_shading_model_standard.fs b/shaders/src/surface_shading_model_standard.fs
index dbf71825..b20bf46f 100644
--- a/shaders/src/surface_shading_model_standard.fs
+++ b/shaders/src/surface_shading_model_standard.fs
@@ -150,6 +150,12 @@ vec3 surfaceShading(const PixelParams pixel, const Light light, float occlusion)
     Fr *= light.specularScale;
 
     vec3 Fd = diffuseLobe(pixel, NoV, NoL, LoH);
+    // per view: material global 3.z != 0 (View::setMaterialGlobal, default 0) selects
+    // filament's stock diffuse instead (patch 0007). Overwrites rather than branches
+    // around the ogre2 lobe, so the default path compiles as before.
+    if (getMaterialGlobal3().z != 0.0) {
+        Fd = pixel.diffuseColor * diffuse(pixel.roughness, NoV, NoL, LoH);
+    }
 #if defined(MATERIAL_HAS_REFRACTION)
     Fd *= (1.0 - pixel.transmission);
 #endif
