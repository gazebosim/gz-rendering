+// 1 / (1 + linear * d + quadratic * d^2) (coefficients and intensity pre-divided by the constant
+// term), zero past the falloff radius, optionally faded linearly to it (patch 0004)
+highp float getPolynomialAttenuation(const highp vec3 posToLight, const highp float falloff,
+        const highp vec2 linearQuadratic, const bool fade) {
+    highp float distanceSquare = dot(posToLight, posToLight);
+    highp float d = sqrt(distanceSquare);
+    highp float attenuation = distanceSquare * falloff <= 1.0 ?
+            1.0 / (1.0 + (linearQuadratic.x + linearQuadratic.y * d) * d) : 0.0;
+    if (fade) {
+        attenuation *= max(1.0 - d * sqrt(falloff), 0.0);
+    }
+    highp vec3 v = getWorldPosition() - getWorldCameraPosition();
+    attenuation *= saturate(frameUniforms.lightFarAttenuationParams.x - dot(v, v) * frameUniforms.lightFarAttenuationParams.y);
+    return attenuation;
+}
+
+// cone ramp raised to an exponent, zero outside the outer cone (patch 0004)
+highp float getAngleAttenuationExponent(const highp vec3 lightDir, const highp vec3 l,
+        const highp vec2 scaleOffset, const highp float exponent) {
+    highp float ramp = dot(lightDir, l) * scaleOffset.x + scaleOffset.y;
+    return ramp >= 0.0 ? pow(min(ramp, 1.0), exponent) : 0.0;
+}
